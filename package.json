{
  "name": "friendsgiving",
  "version": "1.0.0",
  "description": "A private, real-time food signup for Friendsgiving",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-config.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "new-event": "node scripts/new-event.mjs",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^14.27.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  },
  "private": true
}
