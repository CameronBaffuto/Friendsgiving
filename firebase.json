{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "fonts/**/static/**",
      "fonts/**/*Italic*.ttf",
      "assets/illustrations/blue-bow.png",
      "assets/illustrations/cranberry-sprig.png",
      "assets/illustrations/greenery.png",
      "assets/illustrations/holly.png",
      "assets/illustrations/orange-slice.png",
      "assets/illustrations/red-bow.png",
      "assets/illustrations/white-flower.png",
      "assets/decorations/paper-tape.png",
      "assets/decorations/sparkles.png",
      "assets/decorations/star-large.png",
      "assets/decorations/star-medium.png",
      "assets/decorations/star-small.png"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.firebaseio.com/.lp https://*.firebasedatabase.app/.lp; style-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://firebaseinstallations.googleapis.com https://firebase.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app; frame-src 'self' https://*.firebaseio.com/.lp https://*.firebasedatabase.app/.lp; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
